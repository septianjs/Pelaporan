+/*
+ * Versi WEB dari CSS dasar slide laporan (padanan blade pdf/report_16_9.blade.php).
+ * Nilai diturunkan dari blade; warna tema memakai CSS variable --rt-* yang diisi
+ * ReportSlide.vue dari atribut Template::theme (sumber yang sama dengan PDF).
+ * Desain per-template ada di report-templates.css (file yang sama dengan PDF).
+ * Urutan import di app.css: file ini DULU, lalu report-templates.css.
+ *
+ * Catatan kesetaraan dengan DomPDF:
+ *  - DomPDF mengabaikan box-sizing: border-box (padding/border ditambahkan di luar
+ *    width/height), jadi di sini dipaksa content-box agar tata letak sama.
+ *  - Satuan pt dipertahankan; slide dirender 960pt x 540pt lalu diskalakan (transform).
+ */
+
+.rt-scope {
+  position: relative;
+  width: 100%;
+  aspect-ratio: 16 / 9;
+  overflow: hidden;
+  background-color: var(--rt-bg);
+  color: #1e293b;
+  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
+  line-height: normal;
+  text-align: left;
+  user-select: none;
+}
+.rt-scope *,
+.rt-scope *::before,
+.rt-scope *::after {
+  box-sizing: content-box;
+}
+.rt-scope .rt-stage {
+  position: absolute;
+  left: 0;
+  top: 0;
+  width: 960pt;
+  height: 540pt;
+  transform-origin: 0 0;
+}
+.rt-scope img {
+  display: inline;
+  max-width: none;
+}
+.rt-scope .cover-photo-img,
+.rt-scope .cover-photo-placeholder,
+.rt-scope .photo-img {
+  object-fit: cover;
+}
+.rt-scope .cover-photo-img { object-position: 50% 20%; }
+.rt-scope h1 { margin: 0; }
+
+.rt-scope .slide {
+  width: 960pt;
+  height: 540pt;
+  page-break-after: always;
+  position: relative;
+  overflow: hidden;
+  background-color: var(--rt-bg);
+}
+.rt-scope .slide-last {
+  page-break-after: avoid;
+}
+.rt-scope .cover-header {
+  background: var(--rt-primary);
+  height: 70pt;
+  padding: 24pt 50pt;
+  position: relative;
+  border-bottom: 5pt solid var(--rt-accent);
+}
+.rt-scope .cover-badge {
+  color: var(--rt-accent);
+  font-size: 10pt;
+  font-weight: bold;
+  letter-spacing: 2pt;
+  text-transform: uppercase;
+  margin-bottom: 6pt;
+}
+.rt-scope .cover-title {
+  color: #ffffff;
+  font-size: 26pt;
+  font-weight: bold;
+  letter-spacing: 0.5pt;
+  margin: 0;
+  line-height: 1.1;
+}
+.rt-scope .cover-body {
