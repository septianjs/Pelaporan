
Options -Indexes
RewriteEngine On
RewriteBase /pelaporan/

# Lindungi file rahasia dan konfigurasi
<FilesMatch "^(\.env|\.env\..*|artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\..*)$">
    Require all denied
</FilesMatch>

# Blokir folder internal Laravel
RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|vendor|storage/framework|storage/logs)(/|$) - [F,L,NC]

# Arahkan permintaan ke folder public
RewriteRule ^(.*)$ public/$1 [L]
